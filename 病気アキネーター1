<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>病気アキネーター</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Helvetica Neue', Arial, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', sans-serif;
      background-color: #f0f4f8;
      color: #333;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }
    .card {
      background: #ffffff;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      width: 100%;
      max-width: 500px;
      padding: 30px;
      text-align: center;
    }
    h1 {
      font-size: 1.5rem;
      color: #2c3e50;
      margin-bottom: 20px;
    }
    .disease-box {
      background-color: #eef2f5;
      border: 2px dashed #b0bec5;
      border-radius: 12px;
      padding: 25px 15px;
      margin-bottom: 20px;
      min-height: 100px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .disease-name {
      font-size: 1.8rem;
      font-weight: bold;
      color: #1a252f;
      word-break: break-all;
    }
    .timer {
      font-size: 2.5rem;
      font-weight: bold;
      color: #e74c3c;
      margin-bottom: 20px;
      font-variant-numeric: tabular-nums;
    }
    .timer.finished {
      color: #7f8c8d;
    }
    .btn-group {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin-bottom: 25px;
    }
    button {
      padding: 12px 24px;
      font-size: 1rem;
      font-weight: bold;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.2s, transform 0.1s;
    }
    button:active {
      transform: scale(0.98);
    }
    .btn-primary {
      background-color: #3498db;
      color: white;
    }
    .btn-primary:hover {
      background-color: #2980b9;
    }
    .btn-secondary {
      background-color: #95a5a6;
      color: white;
    }
    .btn-secondary:hover {
      background-color: #7f8c8d;
    }
    .csv-section {
      border-top: 1px solid #e0e0e0;
      padding-top: 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .csv-tools {
      display: flex;
      gap: 10px;
      justify-content: center;
    }
    input[type="file"] {
      display: none;
    }
    .file-label {
      padding: 8px 16px;
      font-size: 0.9rem;
      background-color: #ecf0f1;
      color: #2c3e50;
      border-radius: 6px;
      cursor: pointer;
      border: 1px solid #bdc3c7;
    }
    .file-label:hover {
      background-color: #bdc3c7;
    }
    .btn-sub {
      padding: 8px 16px;
      font-size: 0.9rem;
      background-color: #2ecc71;
      color: white;
    }
    .btn-sub:hover {
      background-color: #27ae60;
    }
    .count-info {
      font-size: 0.85rem;
      color: #7f8c8d;
    }
  </style>
</head>
<body>

<div class="card">
  <h1>🩺 病気アキネーター</h1>
  
  <div class="disease-box">
    <div id="diseaseName" class="disease-name">スタートを押してください</div>
  </div>

  <div id="timer" class="timer">01:00</div>

  <div class="btn-group">
    <button id="startBtn" class="btn-primary" onclick="nextDisease()">スタート / 次へ</button>
  </div>

  <div class="csv-section">
    <div class="count-info">登録疾患数: <span id="diseaseCount">0</span> 件</div>
    <div class="csv-tools">
      <label class="file-label">
        CSVを読み込む
        <input type="file" id="csvFileInput" accept=".csv" onchange="importCSV(event)">
      </label>
      <button class="btn-sub" onclick="exportCSV()">CSVを書き出す</button>
    </div>
  </div>
</div>

<script>
  // 初期疾患データ（サンプル）
  const defaultDiseases = [
    "急性心筋梗塞",
    "脳梗塞",
    "肺炎",
    "糖尿病",
    "慢性腎臓病",
    "虫垂炎",
    "クローン病",
    "気胸",
    "肝硬変",
    "胃潰瘍"
  ];

  let diseases = [];
  let timerInterval = null;
  let timeLeft = 60;

  // 初期化処理
  window.onload = function() {
    const saved = localStorage.getItem('akinator_diseases');
    if (saved) {
      diseases = JSON.parse(saved);
    } else {
      diseases = [...defaultDiseases];
      saveToStorage();
    }
    updateCount();
  };

  function saveToStorage() {
    localStorage.setItem('akinator_diseases', JSON.stringify(diseases));
    updateCount();
  }

  function updateCount() {
    document.getElementById('diseaseCount').textContent = diseases.length;
  }

  // タイマーの開始
  function startTimer() {
    clearInterval(timerInterval);
    timeLeft = 60;
    const timerDisplay = document.getElementById('timer');
    timerDisplay.classList.remove('finished');
    updateTimerDisplay();

    timerInterval = setInterval(() => {
      timeLeft--;
      updateTimerDisplay();

      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        timerDisplay.classList.add('finished');
        // 終了後も画面はそのまま維持
      }
    }, 1000);
  }

  function updateTimerDisplay() {
    const minutes = Math.floor(timeLeft / 60);
    const seconds = timeLeft % 60;
    const formatted = 
      String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
    document.getElementById('timer').textContent = formatted;
  }

  // 次の疾患を表示してタイマー再始動
  function nextDisease() {
    if (diseases.length === 0) {
      alert("疾患が登録されていません。CSVから読み込んでください。");
      return;
    }

    // ランダム選出
    const randomIndex = Math.floor(Math.random() * diseases.length);
    const selectedDisease = diseases[randomIndex];

    document.getElementById('diseaseName').textContent = selectedDisease;
    document.getElementById('startBtn').textContent = "次へ";

    startTimer();
  }

  // CSV書き出し
  function exportCSV() {
    if (diseases.length === 0) {
      alert("書き出すデータがありません。");
      return;
    }
    
    // BOMを付与して文字化け防止
    const bom = new Uint8Array([0xEF, 0xBB, 0xBF]);
    const csvContent = diseases.join('\n');
    const blob = new Blob([bom, csvContent], { type: 'text/csv;charset=utf-8;' });
    
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'diseases_list.csv';
    link.click();
  }

  // CSV読み込み
  function importCSV(event) {
    const file = event.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(e) {
      const text = e.target.result;
      // 改行で分割し、空行を除外
      const lines = text.split(/\r\n|\n|\r/)
                        .map(line => line.trim())
                        .filter(line => line.length > 0);

      if (lines.length > 0) {
        diseases = lines;
        saveToStorage();
        alert(`${lines.length} 件の疾患を読み込みました！`);
        document.getElementById('diseaseName').textContent = "「次へ」を押してください";
        clearInterval(timerInterval);
        document.getElementById('timer').textContent = "01:00";
      } else {
        alert("有効な疾患名が見つかりませんでした。");
      }
    };
    reader.readAsText(file);
    // 入力値をリセットして同じファイルの再選択を許可
    event.target.value = '';
  }
</script>

</body>
</html>
